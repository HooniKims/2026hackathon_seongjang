# ─────────────────────────────────────────────────────────────
# 성장형 교사 개발자 플랫폼 — 환경변수 템플릿
#
# 로컬     이 파일을 .env 로 복사해서 값을 채웁니다 (.gitignore 로 커밋 차단)
#            cp .env.example .env
#
# Vercel   같은 이름으로 프로젝트 환경변수에 등록합니다.
#          .env 파일은 배포되지 않습니다.
#            vercel env add UPSTAGE_API_KEY production
#          또는 대시보드 → Settings → Environment Variables
#
# ⚠️ 이 값들은 모두 서버(=서버리스 함수)에서만 읽힙니다.
#    VITE_/NEXT_PUBLIC_ 같은 접두사를 붙이지 마세요. 브라우저로 노출됩니다.
# ─────────────────────────────────────────────────────────────

# ── Upstage AI ────────────────────────────────────────────────
# 발급: https://console.upstage.ai → API Keys
# 인증: Authorization: Bearer $UPSTAGE_API_KEY
# Vercel 필수 등록 항목은 이 하나입니다. 나머지는 기본값이 있습니다.
UPSTAGE_API_KEY=

# 아래는 선택 — 비워두면 코드의 기본값을 씁니다
UPSTAGE_BASE_URL=https://api.upstage.ai/v1

# chat : solar-pro4(최신) | solar-pro3 | solar-pro2 | solar-mini | syn-pro
#        ※ 별칭으로 쓸 것. solar-pro4 → solar-pro4-260806 을 가리킴
UPSTAGE_CHAT_MODEL=solar-pro4

# 아직 쓰지 않지만 확장 시 필요한 것들
#   embedding-passage : 사례집 유사 사례 검색
#   document-parse    : 연수생이 올린 PDF·오피스 파일 파싱
#   information-extract : 스키마 기반 정형 필드 추출
UPSTAGE_EMBEDDING_MODEL=embedding-passage
UPSTAGE_DOCUMENT_MODEL=document-parse
UPSTAGE_EXTRACT_MODEL=information-extract
