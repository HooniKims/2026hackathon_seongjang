# ─────────────────────────────────────────────────────────────
# SEN DEV CONNECT 확장 — 환경변수 템플릿
#
# 이 파일(.env.example)은 "자리"만 표시하는 공개용 템플릿입니다.
# 실제 키는 .env 에 넣으세요. .env 는 .gitignore 로 커밋이 차단됩니다.
#
#   cp .env.example .env   # 그 다음 .env 에 실제 값 입력
# ─────────────────────────────────────────────────────────────

# ── Upstage AI ────────────────────────────────────────────────
# 발급: https://console.upstage.ai  → API Keys
# 인증: Authorization: Bearer $UPSTAGE_API_KEY
UPSTAGE_API_KEY=

# Base URL (기본값 사용 시 수정 불필요)
UPSTAGE_BASE_URL=https://api.upstage.ai/v1

# 사용할 모델
#   chat      : solar-pro4(최신) | solar-pro3 | solar-pro2 | solar-mini | syn-pro
#               ※ 별칭으로 쓸 것. solar-pro4 → solar-pro4-260806 를 가리킴
#               ※ 버전 고정이 필요할 때만 -260806 같은 전체 이름 사용
#   embedding : embedding-query(질의) / embedding-passage(문서)
UPSTAGE_CHAT_MODEL=solar-pro4
UPSTAGE_EMBEDDING_MODEL=embedding-passage

# 문서 처리 모델 (연수생 업로드 파일 → 텍스트/구조 추출)
#   document-parse     : PDF/이미지/오피스 → 구조화된 HTML·마크다운
#   information-extract: 스키마를 주면 정형 필드로 추출
UPSTAGE_DOCUMENT_MODEL=document-parse
UPSTAGE_EXTRACT_MODEL=information-extract


# ── GitLab (axboard 형태 대시보드용, 선택) ────────────────────
# 저장소 통계를 읽어올 때만 필요. read_api 스코프면 충분합니다.
GITLAB_BASE_URL=https://gitlab.aigov.go.kr
GITLAB_TOKEN=
GITLAB_PROJECT_ID=


# ── 앱 설정 ───────────────────────────────────────────────────
# AI 호출은 반드시 서버에서만. 이 값들은 클라이언트로 노출하지 마세요.
NODE_ENV=development
